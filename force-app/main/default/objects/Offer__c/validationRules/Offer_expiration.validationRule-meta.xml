<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offer_expiration</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Offer_Date__c)),
  NOT(ISBLANK(Expiration_Date__c)),
  Expiration_Date__c &lt; Offer_Date__c
)</errorConditionFormula>
    <errorMessage>Error Offer_expiration</errorMessage>
</ValidationRule>
