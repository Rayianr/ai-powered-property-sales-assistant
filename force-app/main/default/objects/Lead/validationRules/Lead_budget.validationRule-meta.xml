<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_budget</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Minimum_Budget__c)),
  NOT(ISBLANK(Maximum_Budget__c)),
  Maximum_Budget__c &lt; Minimum_Budget__c
)</errorConditionFormula>
    <errorMessage>Error Lead_budget</errorMessage>
</ValidationRule>
