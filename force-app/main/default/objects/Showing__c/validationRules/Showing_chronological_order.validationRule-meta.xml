<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Showing_chronological_order</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Start_Date_Time__c)),
  NOT(ISBLANK(End_Date_Time__c)),
  End_Date_Time__c &lt;= Start_Date_Time__c
)</errorConditionFormula>
    <errorMessage>Error Showing_chronological_order</errorMessage>
</ValidationRule>
